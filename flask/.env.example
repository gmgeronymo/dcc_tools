# Modelo de variaveis de ambiente do dccGenerator.
#
# Copie este arquivo para .env (mesma pasta do docker-compose.yml):
#     cp .env.example .env
#     chmod 600 .env
#
# O arquivo .env NAO deve ser versionado (ja consta no .gitignore).

# Chave usada para assinar a sessao da interface web.
# OBRIGATORIA em producao: sem ela, cada worker gera uma chave efemera e as
# sessoes sao invalidadas a cada reinicio (e podem falhar entre workers).
# Gere com:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
DCC_SECRET_KEY=

# Caminho do banco SQLite (opcional; padrao dentro do container: /app/dcc_auth.db).
# DCC_DB_PATH=/app/dcc_auth.db

# Duracao da sessao da interface web, em horas (opcional; padrao: 8).
# DCC_SESSION_HOURS=8

# Hosts confiaveis para download de schemas na validacao de XML (anti-SSRF).
# Lista separada por virgulas; cada entrada cobre o dominio e seus subdominios.
# Padrao: ptb.de,w3.org
# DCC_ALLOWED_SCHEMA_HOSTS=ptb.de,w3.org

# Tamanho maximo (em bytes) de um schema baixado durante a validacao.
# Padrao: 5242880 (5 MiB)
# DCC_MAX_SCHEMA_BYTES=5242880

# ---------------------------------------------------------------------------
# E-mail (recuperacao de senha)
# ---------------------------------------------------------------------------
# Habilita/desabilita o envio de e-mail (padrao: true).
# DCC_EMAIL_ENABLED=true

# Host SMTP do servidor de e-mail (hostname). Sem valor padrao no codigo:
# enquanto nao definido, o envio fica desabilitado.
# SMTP_HOST=

# Porta SMTP.
# SMTP_PORT=587

# Autenticacao SMTP (padrao: sem autenticacao).
# SMTP_USE_AUTH=false
# SMTP_USERNAME=
# SMTP_PASSWORD=

# STARTTLS (padrao: false). Ajustar conforme o servidor de e-mail.
# SMTP_USE_TLS=false

# Remetente dos e-mails. Sem valor padrao no codigo.
# SMTP_FROM=

# Timeout da conexao SMTP, em segundos (padrao: 15).
# SMTP_TIMEOUT=15

# URL base oficial do servico, usada para montar o link de recuperacao de senha.
# Padrao: https://sig-dimci.inmetro.gov.br (definir DCC_* neste arquivo, que e o
# injetado no container; o .env do diretorio pai nao chega ao dccgenerator).
# APP_BASE_URL=https://sig-dimci.inmetro.gov.br

# Validade do token de recuperacao de senha, em minutos (padrao: 60).
# DCC_RESET_TOKEN_MINUTES=60
